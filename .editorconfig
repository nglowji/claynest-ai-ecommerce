root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,py,ps1}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props}]
indent_style = space
indent_size = 2

[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
